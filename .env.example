# ========================================
#  DISTRIBUTED RATE LIMITER CONFIGURATION
# ========================================

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=20
REDIS_CONNECTION_POOL_SIZE=10

# Rate Limiting Settings
DEFAULT_REQUESTS_PER_MINUTE=60
DEFAULT_BURST_SIZE=10
SLIDING_WINDOW_SIZE=300
FIXED_WINDOW_SIZE=60

# Application Settings
DEBUG=false
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
WORKER_PROCESSES=4
KEEP_ALIVE_TIMEOUT=65

# Security Settings
ALLOWED_HOSTS=localhost,127.0.0.1
API_KEY_REQUIRED=false
CORS_ORIGINS=*
SECRET_KEY=your-secret-key-change-in-production

# Monitoring Configuration
METRICS_ENABLED=true
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
DASHBOARD_ENABLED=true
HEALTH_CHECK_INTERVAL=30

# Performance Tuning
ENABLE_REDIS_CLUSTERING=false
REDIS_CLUSTER_NODES=redis-node1:7000,redis-node2:7000,redis-node3:7000
MAX_REQUEST_SIZE=1048576
REQUEST_TIMEOUT=30

# Development Settings (set to false in production)
RELOAD_ON_CHANGE=false
ENABLE_DEBUG_ENDPOINTS=false
VERBOSE_LOGGING=false